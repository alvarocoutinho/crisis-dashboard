ato com a água de alagamentos, pois podem estar contaminadas e provocar doenças.","area_desc":"AMAZONAS/AM","n_ibge":7,"area_km2":120878.4,"first_seen_utc":"2026-10-30T08:48:20Z","ufs":["AM"],"ponto":[-68.7613,-3.1185],"bbox":[-70.445,-6.306,-58.064,0.068]},"geometry":{"type":"MultiPolygon","coordinates":[[[[-59.364,-2.892],[-59.356,-2.822],[-59.311,-2.766],[-59.262,-2.744],[-59.265,-2.725],[-59.232,-2.705],[-59.228,-2.649],[-59.189,-2.597],[-59.195,-2.555],[-59.166,-2.539],[-59.155,-2.517],[-59.131,-2.52],[-59.082,-2.575],[-59.051,-2.586],[-59.048,-2.623],[-59.026,-2.638],[-59.026,-2.697],[-58.983,-2.7],[-58.988,-2.774],[-58.964,-2.779],[-58.964,-2.766],[-58.938,-2.756],[-58.904,-2.777],[-58.915,-2.8],[-58.876,-2.855],[-58.861,-2.856],[-58.877,-2.892],[-58.864,-2.913],[-58.63,-3.038],[-58.566,-3.006],[-58.504,-2.998],[-58.474,-2.976],[-58.401,-3.0],[-58.387,-3.017],[-58.399,-3.025],[-58.408,-3.045],[-58.385,-3.022],[-58.377,-3.033],[-58.379,-3.056],[-58.371,-3.065],[-58.388,-3.083],[-58.376,-3.09],[-58.375,-3.144],[-58.245,-3.082],[-58.177,-3.035],[-58.173,-3.124],[-58.192,-3.187],[-58.081,-3.188],[-58.065,-3.215],[-58.07,-3.306],[-58.108,-3.348],[-58.15,-3.345],[-58.173,-3.36],[-58.181,-3.496],[-58.37,-3.5],[-58.364,-3.515],[-58.383,-3.561],[-58.349,-3.582],[-58.355,-3.6],[-58.342,-3.611],[-58.372,-3.637],[-58.374,-3.676],[-58.4,-3.677],[-58.422,-3.727],[-58.457,-3.706],[-58.464,-3.752],[-58.508,-3.754],[-58.517,-3.712],[-58.553,-3.685],[-58.573,-3.649],[-58.622,-3.623],[-58.646,-3.628],[-58.655,-3.658],[-58.68,-3.664],[-58.701,-3.643],[-58.706,-3.611],[-58.735,-3.592],[-58.787,-3.614],[-58.871,-3.602],[-58.899,-3.618],[-58.919,-3.613],[-58.921,-3.595],[-58.906,-3.583],[-58.917,-3.547],[-58.901,-3.51],[-58.843,-3.452],[-58.803,-3.45],[-58.784,-3.379],[-58.825,-3.401],[-58.857,-3.396],[-58.903,-3.362],[-58.958,-3.271],[-59.0,-3.244],[-59.138,-3.283],[-59.383,-3.181],[-59.351,-3.145],[-59.264,-3.153],[-59.206,-3.179],[-59.159,-3.168],[-59.262,-3.129],[-59.304,-3.131
icas, fique atento às recomendações para estes tipos de ameaças; Auxilie crianças, idosos e pessoas com dificuldade de locomoção próximas a você; Evite contato com a água de alagamentos, pois podem estar contaminadas e provocar doenças.","area_desc":"Tapauá/AM, Juruá/AM","n_ibge":2,"area_km2":105219.7,"first_seen_utc":"2026-10-29T10:14:45Z","ufs":["AM"],"ponto":[-66.0388,-6.026],"bbox":[-67.797,-7.345,-62.102,-2.445]},"geometry":{"type":"MultiPolygon","coordinates":[[[[-67.433,-6.971],[-67.432,-6.972],[-67.433,-6.972],[-67.433,-6.971]]],[[[-67.291,-6.418],[-67.292,-6.419],[-67.292,-6.418],[-67.291,-6.418]]],[[[-66.935,-6.396],[-66.934,-6.395],[-66.934,-6.396],[-66.935,-6.396]]],[[[-67.24,-6.388],[-67.239,-6.389],[-67.24,-6.389],[-67.24,-6.388]]],[[[-67.238,-6.385],[-67.237,-6.385],[-67.238,-6.386],[-67.238,-6.385]]],[[[-67.004,-6.379],[-67.005,-6.38],[-67.005,-6.379],[-67.004,-6.379]]],[[[-67.223,-6.349],[-67.224,-6.35],[-67.224,-6.349],[-67.223,-6.349]]],[[[-67.077,-6.348],[-67.079,-6.351],[-67.078,-6.348],[-67.077,-6.348]]],[[[-67.151,-6.336],[-67.15,-6.337],[-67.151,-6.337],[-67.151,-6.336]]],[[[-67.108,-6.328],[-67.107,-6.329],[-67.108,-6.329],[-67.108,-6.328]]],[[[-66.933,-4.277],[-66.934,-4.276],[-66.933,-4.276],[-66.933,-4.277]]],[[[-67.031,-4.155],[-67.032,-4.156],[-67.032,-4.154],[-67.031,-4.155]]],[[[-67.07,-4.089],[-67.071,-4.088],[-67.07,-4.088],[-67.07,-4.089]]],[[[-67.176,-3.882],[-67.175,-3.883],[-67.176,-3.883],[-67.176,-3.882]]],[[[-66.849,-6.423],[-66.85,-6.426],[-66.85,-6.423],[-66.849,-6.423]]],[[[-66.886,-6.407],[-66.887,-6.408],[-66.887,-6.407],[-66.886,-6.407]]],[[[-67.372,-6.492],[-67.426,-6.519],[-67.454,-6.502],[-67.509,-6.542],[-67.556,-6.54],[-67.632,-6.569],[-67.652,-6.549],[-67.672,-6.561],[-67.71,-6.548],[-67.741,-6.509],[-67.797,-6.519],[-67.74,-6.36],[-67.7,-6.329],[-67.696,-6.301],[-67.671,-6.277],[-67.666,-6.254],[-67.621,-6.239],[-67.644,-6.178],[-67.678,-6.141],[-67.669,-6.043],[-67.695,-6.017],[-67.703,-5.953],[-67.651,-5.937],[
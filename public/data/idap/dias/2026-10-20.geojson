nas podem reduzir a exposição às partículas grossas. Pessoas vulneraveis e doentes crônicos devem evitar exposição. Procure uma unidade médica ao notar dificuldade para respirar.","area_desc":"AMAZONAS/AM","n_ibge":3,"area_km2":53542.8,"first_seen_utc":"2026-10-20T13:42:37Z","ufs":["AM"],"ponto":[-58.2002,-5.242],"bbox":[-60.287,-7.35,-56.913,-3.133]},"geometry":{"type":"MultiPolygon","coordinates":[[[[-58.836,-5.453],[-58.837,-5.456],[-58.838,-5.452],[-58.836,-5.453]]],[[[-58.369,-3.577],[-58.385,-3.553],[-58.364,-3.515],[-58.37,-3.5],[-58.181,-3.496],[-58.183,-3.46],[-58.173,-3.414],[-58.177,-3.367],[-58.167,-3.353],[-58.144,-3.344],[-58.108,-3.348],[-58.087,-3.334],[-58.088,-3.315],[-58.07,-3.306],[-58.062,-3.339],[-58.042,-3.348],[-58.029,-3.34],[-57.95,-3.344],[-57.9,-3.284],[-57.877,-3.293],[-57.862,-3.281],[-57.843,-3.284],[-57.809,-3.224],[-57.794,-3.166],[-57.795,-3.133],[-57.616,-3.133],[-57.609,-3.168],[-57.627,-3.169],[-57.638,-3.211],[-57.636,-3.248],[-57.625,-3.257],[-57.622,-3.278],[-57.627,-3.298],[-57.602,-3.315],[-57.589,-3.339],[-57.548,-3.315],[-57.515,-3.324],[-57.487,-3.443],[-57.434,-3.5],[-57.37,-3.513],[-57.359,-3.544],[-57.343,-3.554],[-57.326,-3.588],[-57.3,-3.595],[-57.294,-3.61],[-57.266,-3.607],[-57.253,-3.624],[-57.258,-3.651],[-57.245,-3.673],[-57.231,-3.665],[-57.2,-3.676],[-57.181,-3.659],[-57.146,-3.661],[-57.132,-3.637],[-57.116,-3.631],[-57.122,-3.602],[-57.114,-3.595],[-57.088,-3.601],[-57.064,-3.592],[-57.022,-3.602],[-56.989,-3.576],[-56.965,-3.582],[-56.929,-3.56],[-56.913,-3.562],[-58.255,-6.454],[-58.266,-6.475],[-58.286,-6.49],[-58.327,-6.5],[-58.332,-6.532],[-58.349,-6.562],[-58.427,-6.616],[-58.478,-6.699],[-58.481,-6.781],[-58.434,-6.908],[-58.38,-6.97],[-58.355,-6.971],[-58.335,-6.986],[-58.288,-7.061],[-58.245,-7.088],[-58.209,-7.134],[-58.18,-7.181],[-58.167,-7.239],[-58.174,-7.271],[-58.17,-7.313],[-58.147,-7.343],[-58.5,-7.35],[-58.54,-7.342],[-58.574,-7.287],[-58.529,-7.237],[-58.563,-7.198],[-58.529,-7.186],[-58.